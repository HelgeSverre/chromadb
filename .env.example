CHROMA_VERSION=1.5.7
CHROMADB_TOKEN=test-token-chroma-local-dev
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
CHROMADB_EMBEDDING_PROVIDER="openai"

# Integration Test API Keys (optional - tests skip if not set)
# Uncomment and set these to run integration tests with real APIs
MISTRAL_API_KEY=replace-this
OPENAI_API_KEY=replace-this
OLLAMA_BASE_URL=replace-this
JINA_API_KEY=replace-this
VOYAGE_API_KEY=replace-this

# Chroma Cloud Integration Test Credentials (optional - for testing attached functions)
# CHROMA_CLOUD_API_KEY=replace-this
# CHROMA_CLOUD_TENANT=replace-this
# CHROMA_CLOUD_DATABASE=replace-this
